# Copy this file to .env and fill in your keys.

# Jev (TypeSafe) decision model — https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=sk-...

# Langfuse tracing (optional — the agent runs fine without these, tracing
# just no-ops) — https://cloud.langfuse.com, Settings > API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
